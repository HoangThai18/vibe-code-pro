<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Spa.Api</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- The migration bundle builds for a runtime: list it, or the bundle rewrites packages.lock.json -->
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" PrivateAssets="all" />
    <!-- The provider asks for EF Core >= 10.0.4; without this the test project gets 10.0.4 and Design's 10.0.14 clash -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The canonical SQL (postgres-rls.md, data-layer.md), applied by the hand-written migrations -->
    <EmbeddedResource Include="../../sql/current-tenant.sql;../../sql/tenant-isolation.sql;../../sql/login.sql;../../sql/no-overlap.sql;Data/Sql/*.sql" LogicalName="sql/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
