{
  "name": "i18n-check",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p . && tsc -p tsconfig.next.json",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "check:messages": "node --import tsx src/i18n/check-messages.ts messages",
    "build:web": "next build",
    "test:web": "node --import tsx --test test-web/hydration.test.ts",
    "safeguards": "python3 scripts/safeguards.py",
    "explain": "psql \"$DATABASE_URL\" -f sql/explain.sql",
    "verify": "npm run typecheck && npm test && npm run check:messages"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright-core": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.22",
    "intl-messageformat": "12.1.4",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
