{
    "name": "vibe/verify-laravel",
    "type": "project",
    "description": "The code behind vibe-backend/references/laravel.md (Laravel 13, MySQL 8.4).",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "13.38.0",
        "laravel/sanctum": "4.3.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.3.6"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
