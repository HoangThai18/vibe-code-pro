{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "spa-crm",
  "version": "0.1.0",
  "identifier": "vn.example.spacrm",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "Spa CRM",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIyQUI0ODFDMjIzQTIyNTUKUldSVklqb2lIRWlyc2tnY0gxUXlGemJKVyszVHUyOW5ONmg0M3BxclkrbitWQ2FLMzhzSXJ1MGgK",
      "endpoints": [
        "https://releases.example.vn/spa-crm/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  }
}